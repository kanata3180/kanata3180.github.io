---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	currentCategory?: string;
}

const { title, description, currentCategory } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700;900&family=Noto+Sans+JP:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
	</head>
	<body>
		<header class="masthead">
			<div class="masthead-inner">
				<a href={base} class="logo">
					<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 19L9 7l4 6.5L15.5 9 22 19H2z" fill="currentColor"/></svg>
					稜線ノート
				</a>
				<div class="util-icons">
					<a href={`${base}#search`}>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
						検索
					</a>
					<details class="menu-toggle">
						<summary>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
							メニュー
						</summary>
						<div class="menu-panel">
							<a href={base}>トップ</a>
							<a href={`${base}backpack-comparison/`}>ザック</a>
							<a href={`${base}tent-comparison/`}>テント</a>
							<a href={`${base}#search`}>記事を検索</a>
						</div>
					</details>
				</div>
			</div>
			<nav class="cat-nav">
				<div class="cat-nav-inner">
					<a href={base} class={!currentCategory ? 'current' : ''}>トップ</a>
					<a href={`${base}backpack-comparison/`} class={currentCategory === 'ザック' ? 'current' : ''}>ザック</a>
					<a href={`${base}tent-comparison/`} class={currentCategory === 'テント' ? 'current' : ''}>テント</a>
				</div>
			</nav>
		</header>

		<div class="page-wrap">
			<slot />

			<footer class="site-foot">
				<div class="foot-inner">
					<div class="foot-links">
						<a href={base}>トップ</a><a href={`${base}backpack-comparison/`}>ザック</a><a href={`${base}tent-comparison/`}>テント</a>
					</div>
					<p class="foot-disclosure"><strong>本ページはプロモーションを含みます。</strong>稜線ノートは実際に検討した登山装備の一次情報をもとに構成しています。紹介リンク経由の購入により、当サイトが紹介料を受け取る場合があります。</p>
				</div>
			</footer>
		</div>
	</body>
</html>
