	</head>
	<body>
		<header class="masthead">
			<div class="masthead-inner">
				<a href={base} class="logo">
					<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 19L9 7l4 6.5L15.5 9 22 19H2z" fill="currentColor"/></svg>
					稜線ノート
				</a>
