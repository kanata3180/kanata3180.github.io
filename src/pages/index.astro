---
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles, upcomingTopics } from '../data/articles.js';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
	title="稜線ノート | 登山装備の軽量化を、一次情報で見直す"
	description="登山装備の見直し記録を、実際に検討した一次情報に基づいて公開する軽量化シリーズ。"
>
	<main>
		<h1 class="title">登山装備の軽量化を、一次情報で見直す</h1>
		<p class="lede">
			「最軽量だから良い」ではなく、山での信頼性とのバランスを考えながら実際に検討した装備見直しの記録です。装備カテゴリごとに、比較検討の過程をそのまま公開しています。
		</p>

		<section id="search">
			<h2>記事を探す</h2>
			<div class="search-box">
				<input type="search" id="search-input" placeholder="キーワードで記事を検索（例: ザック、テント）" aria-label="記事を検索" />
			</div>

			<div class="article-list" id="article-list">
				{articles.map((article) => (
					<a class="article-row" href={`${base}${article.slug}/`} data-title={article.title} data-category={article.category}>
						<div class="thumb-static">
							<svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
								<defs>
									<linearGradient id={`grad-${article.slug}`} x1="0" y1="0" x2="0" y2="1">
										<stop offset="0%" stop-color={article.thumbColors[0]} />
										<stop offset="100%" stop-color={article.thumbColors[1]} />
									</linearGradient>
								</defs>
								<rect width="100" height="100" fill={`url(#grad-${article.slug})`} />
							</svg>
						</div>
						<div>
							<span class="cat-tag">{article.category}</span>
							<p class="row-title">{article.title}</p>
							<p class="row-excerpt">{article.excerpt}</p>
						</div>
					</a>
				))}
			</div>
			<p class="search-empty" id="search-empty">該当する記事が見つかりませんでした。</p>
		</section>

		{upcomingTopics.length > 0 && (
			<section class="topics-section">
				<h2>今後のトピックス</h2>
				<p class="topics-desc">同じ軽量化プロジェクトの一環として、以下のカテゴリも記事化を進めています。</p>
				<div class="topics-grid">
					{upcomingTopics.map((topic) => (
						<div class="topic-card">
							<div class="topic-thumb soon">
								<svg viewBox="0 0 300 110" preserveAspectRatio="xMidYMid slice"><rect width="300" height="110" fill={topic.color} /></svg>
								<span class="tag">{topic.category}</span>
								<span class="soon-badge">準備中</span>
							</div>
							<p class="topic-title">{topic.title}</p>
						</div>
					))}
				</div>
			</section>
		)}
	</main>
</BaseLayout>

<script>
	const input = document.getElementById('search-input') as HTMLInputElement | null;
	const rows = document.querySelectorAll<HTMLElement>('#article-list [data-title]');
	const empty = document.getElementById('search-empty');

	function applyFilter(query: string) {
		const q = query.trim().toLowerCase();
		let visible = 0;
		rows.forEach((row) => {
			const hay = `${row.dataset.title ?? ''} ${row.dataset.category ?? ''}`.toLowerCase();
			const match = q === '' || hay.includes(q);
			row.style.display = match ? '' : 'none';
			if (match) visible += 1;
		});
		if (empty) empty.classList.toggle('is-visible', visible === 0);
	}

	if (input) {
		const params = new URLSearchParams(window.location.search);
		const initial = params.get('q') ?? '';
		input.value = initial;
		applyFilter(initial);
		input.addEventListener('input', (e) => {
			applyFilter((e.target as HTMLInputElement).value);
		});
	}
</script>
