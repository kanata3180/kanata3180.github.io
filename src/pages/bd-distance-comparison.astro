---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorBox from '../components/AuthorBox.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ProductCardList from '../components/ProductCardList.astro';
import SpecTable from '../components/SpecTable.astro';
import Callout from '../components/Callout.astro';
import { bdDistance8, bdDistance15, bdDistance22 } from '../data/products/index.js';

const base = import.meta.env.BASE_URL;

const cardConfigs = [
	{ product: bdDistance8, conditionLabel: 'スピード重視のファストハイク・軽量日帰りなら' },
	{ product: bdDistance15, conditionLabel: '日帰り〜1泊程度の汎用性を求めるなら' },
	{ product: bdDistance22, conditionLabel: '暖かい季節のテント泊装備まで持ち運びたいなら' },
];
const products = cardConfigs.map((c) => c.product);

const specFields = [
	{ key: 'capacity', label: '容量', numeric: true },
	{ key: 'weight', label: '重量', numeric: true, best: 'bd-distance-8' },
	{ key: 'priceLabel', label: '価格' },
	{ key: 'chestCircumference', label: '胸囲対応（サイズ展開）' },
	{ key: 'colors', label: 'カラー展開' },
	{ key: 'material', label: '素材' },
	{ key: 'madeIn', label: '製造国' },
	{ key: 'features', label: '主な機能' },
];
---

<BaseLayout
	title="Black Diamond ディスタンス全3容量、どう選ぶか | やまかなた"
	description="ランニングベストとバックパックの中間に位置するディスタンスシリーズ全3容量（8L・15L・22L）を、用途別に整理しました。"
	currentCategory="ザック"
>
	<main>
		<p class="breadcrumb"><a href={base}>ホーム</a> &gt; ザック &gt; ディスタンス比較</p>

		<div class="meta-row">
			<span class="cat-tag">ザック</span>
			<span class="pub-date">{bdDistance8.verifiedDate} 更新（仮記事）</span>
		</div>

		<h1 class="title">Black Diamond ディスタンス全3容量、どう選ぶか</h1>

		<div class="hero">
			<svg viewBox="0 0 900 260" preserveAspectRatio="xMidYMid slice" role="img" aria-label="ランニングベストのイラスト">
				<defs>
					<linearGradient id="sky6" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0%" stop-color="#1d5c6b"/>
						<stop offset="100%" stop-color="#3a8f9e"/>
					</linearGradient>
				</defs>
				<rect width="900" height="260" fill="url(#sky6)"/>
				<path d="M0,210 L180,150 L340,200 L520,140 L700,195 L900,150 L900,260 L0,260 Z" fill="#123a44" opacity="0.6"/>
			</svg>
		</div>

		<p class="lede">
			Black Diamond ディスタンスシリーズは、ランニングベストとバックパックの中間に位置するハイブリッドパックで、8L・15L・22Lの3容量が展開されている。同じシリーズ内でどの容量を選ぶべきか、用途別に整理した。
		</p>

		<TableOfContents items={[
			{ href: '#candidates', label: '3容量の比較' },
			{ href: '#spec', label: '詳細スペック比較' },
			{ href: '#verdict', label: '結論' },
		]} />

		<Callout kicker="データ出典についての注記">
			<p>本記事の3製品は、いずれもBlue Sheepオンラインストア（Black Diamond日本正規代理店。2026年にLost Arrowから移管）の商品ページに出典を統一している。</p>
			<p>また、各モデルには型番末尾が異なる<strong>ウィメンズ版</strong>（BD56708〜710001004）も同価格で用意されている。ウィメンズ版は対応胸囲がメンズ版よりひとまわり小さく設定されており（例：ディスタンス22はメンズS67-85cm／M80-100cm／L90-112cmに対し、ウィメンズはS60-75cm／M67-85cm／L80-100cm）、肩ベルト形状も女性向けに最適化されている。重量はメンズ版と同一表記だった（M：ディスタンス15が330g、ディスタンス22が400g）。</p>
		</Callout>

		<ProductCardList
			heading="3容量の比較"
			cards={cardConfigs}
			specs={[{ label: '容量', key: 'capacity' }, { label: '重量', key: 'weight' }]}
			icon={`<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 5v2l-3 3 2 2v10h12V12l2-2-3-3V5Q12 8 7 5Z" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>`}
		/>

		<SpecTable caption={`${bdDistance8.verifiedDate}時点のBlue Sheep公式サイト調査データ`} products={products} specFields={specFields} />

		<section id="verdict">
			<h2>結論</h2>
			<div class="verdict">
				<p class="kicker">容量別の使い分け</p>
				<p>3容量とも同じシリーズのハイブリッド設計思想を共有しており、優劣ではなく用途の広さで選ぶ比較になる。</p>

				<div class="verdict-point">
					<p class="point-label">スピード重視のファストハイク・軽量日帰りなら</p>
					<p><strong>{bdDistance8.model}</strong>が候補になる。3容量中最軽量で、必要最小限の装備で身軽に動きたい場合に向く。ただし胸囲対応はSサイズの記載のみ確認できており、他サイズの展開は個別に確認が必要。</p>
				</div>

				<div class="verdict-point">
					<p class="point-label">日帰り〜1泊程度の汎用性を求めるなら</p>
					<p><strong>{bdDistance15.model}</strong>が候補になる。胸囲対応がS/M/Lの3段階（67-85cm／80-100cm／90-112cm）に分かれ、体格に合わせて選びやすい。フロント・ショルダー・サイドと収納箇所が細かく分かれている。</p>
				</div>

				<div class="verdict-point">
					<p class="point-label">暖かい季節のテント泊装備まで持ち運びたいなら</p>
					<p><strong>{bdDistance22.model}</strong>が候補になる。3容量中最大の22Lで、S/M/Lごとに胸囲対応（67-85cm／80-100cm／90-112cm）が明記されており、体格差によるフィット感の違いを事前に把握しやすい。</p>
				</div>

				<p>いずれも本格的なテント泊縦走用ザックの代替ではなく、行動中の身軽さを優先したハイブリッドパックという位置づけである点は共通している。</p>
			</div>
		</section>

		<AuthorBox />
	</main>
</BaseLayout>
