---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorBox from '../components/AuthorBox.astro';
import { auroraLight350DX, uddBag380DX } from '../data/products/index.js';

const base = import.meta.env.BASE_URL;

const cardConfigs = [
	{ product: auroraLight350DX, conditionLabel: '初期投資を避けたいなら（現行品）' },
	{ product: uddBag380DX, conditionLabel: '軽量化と保温力を両方求めるなら' },
];
const products = cardConfigs.map((c) => c.product);

const specFields = [
	{ key: 'weight', label: '総重量', numeric: true, best: 'udd-bag-380dx' },
	{ key: 'downWeight', label: 'ダウン量', numeric: true, best: 'udd-bag-380dx' },
	{ key: 'fillPower', label: 'フィルパワー', numeric: true, best: 'udd-bag-380dx' },
	{ key: 'comfortTemp', label: '快適温度', numeric: true, best: 'udd-bag-380dx' },
	{ key: 'limitTemp', label: '下限温度', numeric: true, best: 'udd-bag-380dx' },
	{ key: 'priceLabel', label: '価格' },
	{ key: 'fabric', label: '表地' },
];

function isBest(field, product) {
	if (!field.best) return false;
	return Array.isArray(field.best) ? field.best.includes(product.id) : field.best === product.id;
}
---

<BaseLayout
	title="NANGA UDD BAG 380DXへの買い替えで軽量化と保温力は両立するか | やまかなた"
	description="現行のNANGAオーロラlight 350DXとUDD BAG 380DXを比較。軽量化と保温力向上は本当に同時に得られるのか検証。"
	currentCategory="シュラフ"
>
	<main>
		<p class="breadcrumb"><a href={base}>ホーム</a> &gt; シュラフ &gt; NANGA UDD BAG 380DX検討</p>

		<div class="meta-row">
			<span class="cat-tag">シュラフ</span>
			<span class="pub-date">{auroraLight350DX.verifiedDate} 更新（仮記事）</span>
		</div>

		<h1 class="title">NANGA UDD BAG 380DXへの買い替えで軽量化と保温力は両立するか</h1>

		<div class="hero">
			<svg viewBox="0 0 900 260" preserveAspectRatio="xMidYMid slice" role="img" aria-label="シュラフのイラスト">
				<defs>
					<linearGradient id="sky3" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0%" stop-color="#235953"/>
						<stop offset="100%" stop-color="#4b978a"/>
					</linearGradient>
				</defs>
				<rect width="900" height="260" fill="url(#sky3)"/>
				<ellipse cx="450" cy="180" rx="260" ry="55" fill="#123430" opacity="0.5"/>
			</svg>
		</div>

		<p class="lede">
			現行使用中の{auroraLight350DX.brand} {auroraLight350DX.model}から、同社の{uddBag380DX.model}への買い替えを検討しました。単純な軽量化ではなく、保温力とのトレードオフが本当に無いのかを数値で確認しています。
		</p>

		<div class="toc">
			<p class="toc-label">目次</p>
			<ol>
				<li><a href="#candidates">現行品と買い替え候補</a></li>
				<li><a href="#spec">詳細スペック比較</a></li>
				<li><a href="#verdict">結論</a></li>
			</ol>
		</div>

		<section id="candidates">
			<h2>現行品と買い替え候補</h2>
			<div class="product-list">
				{cardConfigs.map(({ product, conditionLabel }) => (
					<div class="product-card">
						<div class="thumb"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 8c0-2 2-4 8-4s8 2 8 4v8c0 2-2 4-8 4s-8-2-8-4V8z" stroke="currentColor" stroke-width="1.6"/></svg></div>
						<div class="product-body">
							<p class="condition-label">{conditionLabel}</p>
							<p class="brand-name">{product.brand}</p>
							<p class="model-name">{product.model}</p>
							<p class="spec-line"><span>総重量 <b>{product.weight}</b></span><span>快適温度 <b>{product.comfortTemp}</b></span><span>下限温度 <b>{product.limitTemp}</b></span></p>
							<div class="shop-buttons">
								<span class="shop-btn-pending">Amazon商品リンク：準備中</span>
							</div>
						</div>
					</div>
				))}
			</div>
		</section>

		<section id="spec">
			<h2>詳細スペック比較</h2>
			<div class="table-wrap">
				<table>
					<caption>{auroraLight350DX.verifiedDate}時点の調査データ</caption>
					<thead>
						<tr><th scope="col">項目</th>{products.map((p) => <th scope="col">{p.model}</th>)}</tr>
					</thead>
					<tbody>
						{specFields.map((field) => (
							<tr>
								<th scope="row">{field.label}</th>
								{products.map((p) => (
									<td class:list={[field.numeric && 'num', isBest(field, p) && 'best']}>{p[field.key]}</td>
								))}
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>

		<section id="verdict">
			<h2>結論</h2>
			<div class="verdict">
				<p class="kicker">条件別の整理</p>
				<p>通常、ダウン量を増やせば重量も増えるが、今回は表地がオーロラlight系の機能重視素材「オーロラテックスR」から、よりシンプルな撥水加工生地に変わったことが軽量化要因と推定され、軽量化と保温力向上が両立する組み合わせになっている。</p>

				<div class="verdict-point">
					<p class="point-label">軽量化と保温力を両方求めるなら</p>
					<p><strong>{uddBag380DX.model}</strong>が候補になる。{uddBag380DX.priceLabel}の投資で、総重量-70g・下限温度{uddBag380DX.limitTemp}という、通常はトレードオフになりやすい2つの指標が同時に改善する。ダウン量・フィルパワーともに現行品を上回っている。</p>
				</div>

				<div class="verdict-point">
					<p class="point-label">初期投資を避けたいなら</p>
					<p>現行の{auroraLight350DX.model}を使い続ける選択肢もある。快適温度{auroraLight350DX.comfortTemp}・下限温度{auroraLight350DX.limitTemp}は3シーズンの用途では引き続き実用範囲であり、買い替えが必須というわけではない。</p>
				</div>
			</div>
		</section>

		<AuthorBox />
	</main>
</BaseLayout>
