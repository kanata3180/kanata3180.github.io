---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorBox from '../components/AuthorBox.astro';
import { trentFlyer, everbreathPhoton, tsurugiLightJacket, featherRainJacket, arcteryxBetaSL } from '../data/products/index.js';

const base = import.meta.env.BASE_URL;

const cardConfigs = [
	{ product: tsurugiLightJacket, conditionLabel: '色・入手性・耐摩耗性のバランスを重視するなら' },
	{ product: trentFlyer, conditionLabel: '初期投資を避けたいなら（現行品）' },
	{ product: featherRainJacket, conditionLabel: '耐摩耗性を最優先するなら（現在色欠品）' },
];

const tableProducts = [trentFlyer, everbreathPhoton, tsurugiLightJacket, featherRainJacket, arcteryxBetaSL];
const specFields = [
	{ key: 'weightDiff', label: '重量差', numeric: true, best: ['tsurugi-light-jacket', 'feather-rain-jacket'] },
	{ key: 'priceLabel', label: '価格' },
	{ key: 'fabric', label: '表地', best: 'tsurugi-light-jacket' },
	{ key: 'waterproofRating', label: '耐水圧', best: 'tsurugi-light-jacket' },
	{ key: 'breathability', label: '透湿性', best: 'trent-flyer' },
	{ key: 'abrasionResistance', label: '耐摩耗性', best: ['tsurugi-light-jacket', 'feather-rain-jacket', 'arcteryx-beta-sl'] },
	{ key: 'naturalColor', label: 'ナチュラル色', best: ['everbreath-photon', 'tsurugi-light-jacket', 'arcteryx-beta-sl'] },
	{ key: 'availability', label: '入手性', best: 'trent-flyer' },
];

function isBest(field, product) {
	if (!field.best) return false;
	return Array.isArray(field.best) ? field.best.includes(product.id) : field.best === product.id;
}
---

<BaseLayout
	title="ツルギライトジャケット、兼用運用で本当に摩耗は増えるか | やまかなた"
	description="モンベル トレントフライヤーからの買い替えでTeton Bros ツルギライトジャケットを比較検討。ウィンドジャケット兼用時の摩耗増加も含めて検証。"
	currentCategory="レインウェア"
>
	<main>
		<p class="breadcrumb"><a href={base}>ホーム</a> &gt; レインウェア &gt; ツルギライトジャケット検討</p>

		<div class="meta-row">
			<span class="cat-tag">レインウェア</span>
			<span class="pub-date">{trentFlyer.verifiedDate} 更新（仮記事）</span>
		</div>

		<h1 class="title">ツルギライトジャケット、兼用運用で本当に摩耗は増えるか</h1>

		<div class="hero">
			<svg viewBox="0 0 900 260" preserveAspectRatio="xMidYMid slice" role="img" aria-label="レインウェアのイラスト">
				<defs>
					<linearGradient id="sky4" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0%" stop-color="#b95c08"/>
						<stop offset="100%" stop-color="#e0720e"/>
					</linearGradient>
				</defs>
				<rect width="900" height="260" fill="url(#sky4)"/>
				<path d="M0,210 L200,140 L400,200 L600,130 L800,190 L900,160 L900,260 L0,260 Z" fill="#8a4306" opacity="0.5"/>
			</svg>
		</div>

		<p class="lede">
			現行の{trentFlyer.brand} {trentFlyer.model}（ブルーのみ）から、ナチュラルカラー×同等品質・重量のレインジャケットへの買い替えを検討しました。ウィンドジャケット兼用運用時の摩耗増加リスクも含めて比較しています。
		</p>

		<div class="toc">
			<p class="toc-label">目次</p>
			<ol>
				<li><a href="#candidates">候補3機種</a></li>
				<li><a href="#spec">詳細スペック比較</a></li>
				<li><a href="#verdict">結論</a></li>
			</ol>
		</div>

		<section id="candidates">
			<h2>候補3機種</h2>
			<div class="product-list">
				{cardConfigs.map(({ product, conditionLabel }) => (
					<div class="product-card">
						<div class="thumb"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 4h4l2 2 2-2h4l2 4-3 2v12H7V10L4 8z" stroke="currentColor" stroke-width="1.4" fill="none"/></svg></div>
						<div class="product-body">
							<p class="condition-label">{conditionLabel}</p>
							<p class="brand-name">{product.brand}</p>
							<p class="model-name">{product.model}</p>
							<p class="spec-line"><span>重量 <b>{product.weight}</b></span></p>
							<div class="shop-buttons">
								<span class="shop-btn-pending">Amazon商品リンク：準備中</span>
							</div>
						</div>
					</div>
				))}
			</div>
		</section>

		<section id="spec">
			<h2>詳細スペック比較</h2>
			<div class="table-wrap">
				<table>
					<caption>{trentFlyer.verifiedDate}時点の調査データ</caption>
					<thead>
						<tr><th scope="col">製品</th>{specFields.map((f) => <th scope="col">{f.label}</th>)}</tr>
					</thead>
					<tbody>
						{tableProducts.map((p) => (
							<tr>
								<th scope="row">{p.model}{p.id === 'trent-flyer' && '（現行）'}</th>
								{specFields.map((field) => (
									<td class:list={[field.numeric && 'num', isBest(field, p) && 'best']}>{p[field.key]}</td>
								))}
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>

		<section id="verdict">
			<h2>結論</h2>
			<div class="verdict">
				<p class="kicker">条件別の整理</p>
				<p>現行のトレントフライヤーはモンベル公式が「極薄素材のため鋭利な岩角等で破損の恐れ」と注意書きしており、兼用運用を前提にすると耐摩耗性が判断の軸になる。</p>

				<div class="verdict-point">
					<p class="point-label">色・入手性・耐摩耗性のバランスを重視するなら</p>
					<p><strong>{tsurugiLightJacket.model}</strong>（{tsurugiLightJacket.naturalColor}、{tsurugiLightJacket.priceLabel}）が候補になる。重量増は{tsurugiLightJacket.weightDiff}と小さく、耐摩耗性も公式に明記されている。ナチュラルカラーの在庫もある。</p>
				</div>

				<div class="verdict-point">
					<p class="point-label">耐摩耗性を最優先するなら</p>
					<p><strong>{featherRainJacket.model}</strong>は耐摩耗性（20万回耐摩耗試験クリア）・重量（{featherRainJacket.weightDiff}）の面でむしろ優位だが、唯一のナチュラル色（Forest Green）が現在完売中のため、在庫が戻るまでは選択できない。</p>
				</div>

				<div class="verdict-point">
					<p class="point-label">初期投資を避けたいなら</p>
					<p>現行の{trentFlyer.model}を使い続け、運用でカバーする方法もある。日帰り等の軽装時はウィンドジャケットと両方携行し、10kg超の重量級山行時のみレインジャケット1着で兼用すれば、摩耗増加は限定的に抑えられる。</p>
				</div>
			</div>
		</section>

		<AuthorBox />
	</main>
</BaseLayout>
