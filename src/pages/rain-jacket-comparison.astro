---
import BaseLayout from '../layouts/BaseLayout.astro';
import { trentFlyer, everbreathPhoton, tsurugiLightJacket, featherRainJacket, arcteryxBetaSL } from '../data/products/index.js';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
	title="ツルギライトジャケット、兼用運用で本当に摩耗は増えるか | 稜線ノート"
	description="モンベル トレントフライヤーからの買い替えでTeton Bros ツルギライトジャケットを比較検討。ウィンドジャケット兼用時の摩耗増加も含めて検証。"
	currentCategory="レインウェア"
>
	<main>
		<p class="breadcrumb"><a href={base}>ホーム</a> &gt; レインウェア &gt; ツルギライトジャケット検討</p>

		<div class="meta-row">
			<span class="cat-tag">レインウェア</span>
			<span class="pub-date">{trentFlyer.verifiedDate} 更新（仮記事）</span>
		</div>

		<h1 class="title">ツルギライトジャケット、兼用運用で本当に摩耗は増えるか</h1>

		<div class="hero">
			<svg viewBox="0 0 900 260" preserveAspectRatio="xMidYMid slice" role="img" aria-label="レインウェアのイラスト">
				<defs>
					<linearGradient id="sky4" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0%" stop-color="#b95c08"/>
						<stop offset="100%" stop-color="#e0720e"/>
					</linearGradient>
				</defs>
				<rect width="900" height="260" fill="url(#sky4)"/>
				<path d="M0,210 L200,140 L400,200 L600,130 L800,190 L900,160 L900,260 L0,260 Z" fill="#8a4306" opacity="0.5"/>
			</svg>
		</div>

		<p class="lede">
			現行の{trentFlyer.brand} {trentFlyer.model}（ブルーのみ）から、ナチュラルカラー×同等品質・重量のレインジャケットへの買い替えを検討しました。ウィンドジャケット兼用運用時の摩耗増加リスクも含めて比較しています。
		</p>

		<div class="toc">
			<p class="toc-label">目次</p>
			<ol>
				<li><a href="#candidates">候補3機種</a></li>
				<li><a href="#spec">詳細スペック比較</a></li>
				<li><a href="#verdict">結論</a></li>
			</ol>
		</div>

		<section id="candidates">
			<h2>候補3機種</h2>
			<div class="product-list">

				<div class="product-card">
					<div class="thumb"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 4h4l2 2 2-2h4l2 4-3 2v12H7V10L4 8z" stroke="currentColor" stroke-width="1.4" fill="none"/></svg></div>
					<div class="product-body">
						<p class="condition-label">色・入手性・耐摩耗性のバランスを重視するなら</p>
						<p class="brand-name">{tsurugiLightJacket.brand}</p>
						<p class="model-name">{tsurugiLightJacket.model}</p>
						<p class="spec-line"><span>重量 <b>{tsurugiLightJacket.weight}</b></span></p>
						<div class="shop-buttons">
							<span class="shop-btn-pending">Amazon商品リンク：準備中</span>
						</div>
					</div>
				</div>

				<div class="product-card">
					<div class="thumb"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 4h4l2 2 2-2h4l2 4-3 2v12H7V10L4 8z" stroke="currentColor" stroke-width="1.4" fill="none"/></svg></div>
					<div class="product-body">
						<p class="condition-label">初期投資を避けたいなら（現行品）</p>
						<p class="brand-name">{trentFlyer.brand}</p>
						<p class="model-name">{trentFlyer.model}</p>
						<p class="spec-line"><span>重量 <b>{trentFlyer.weight}</b></span></p>
						<div class="shop-buttons">
							<span class="shop-btn-pending">Amazon商品リンク：準備中</span>
						</div>
					</div>
				</div>

				<div class="product-card">
					<div class="thumb"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 4h4l2 2 2-2h4l2 4-3 2v12H7V10L4 8z" stroke="currentColor" stroke-width="1.4" fill="none"/></svg></div>
					<div class="product-body">
						<p class="condition-label">耐摩耗性を最優先するなら（現在色欠品）</p>
						<p class="brand-name">{featherRainJacket.brand}</p>
						<p class="model-name">{featherRainJacket.model}</p>
						<p class="spec-line"><span>重量 <b>{featherRainJacket.weight}</b></span></p>
						<div class="shop-buttons">
							<span class="shop-btn-pending">Amazon商品リンク：準備中</span>
						</div>
					</div>
				</div>

			</div>
		</section>

		<section id="spec">
			<h2>詳細スペック比較</h2>
			<div class="table-wrap">
				<table>
					<caption>{trentFlyer.verifiedDate}時点の調査データ</caption>
					<thead>
						<tr><th scope="col">製品</th><th scope="col">重量差</th><th scope="col">表地</th><th scope="col">耐摩耗性</th><th scope="col">ナチュラル色</th><th scope="col">入手性</th></tr>
					</thead>
					<tbody>
						<tr><th scope="row">{trentFlyer.model}（現行）</th><td>{trentFlyer.weightDiff}</td><td>{trentFlyer.fabric}</td><td>{trentFlyer.abrasionResistance}</td><td>{trentFlyer.naturalColor}</td><td class="best">{trentFlyer.availability}</td></tr>
						<tr><th scope="row">{everbreathPhoton.model}</th><td class="num">{everbreathPhoton.weightDiff}</td><td>{everbreathPhoton.fabric}</td><td>{everbreathPhoton.abrasionResistance}</td><td class="best">{everbreathPhoton.naturalColor}</td><td>{everbreathPhoton.availability}</td></tr>
						<tr><th scope="row">{tsurugiLightJacket.model}</th><td class="num best">{tsurugiLightJacket.weightDiff}</td><td class="best">{tsurugiLightJacket.fabric}</td><td class="best">{tsurugiLightJacket.abrasionResistance}</td><td class="best">{tsurugiLightJacket.naturalColor}</td><td class="best">{tsurugiLightJacket.availability}</td></tr>
						<tr><th scope="row">{featherRainJacket.model}</th><td class="num best">{featherRainJacket.weightDiff}</td><td>{featherRainJacket.fabric}</td><td class="best">{featherRainJacket.abrasionResistance}</td><td>{featherRainJacket.naturalColor}</td><td>{featherRainJacket.availability}</td></tr>
						<tr><th scope="row">{arcteryxBetaSL.model}</th><td class="num">{arcteryxBetaSL.weightDiff}</td><td>{arcteryxBetaSL.fabric}</td><td class="best">{arcteryxBetaSL.abrasionResistance}</td><td class="best">{arcteryxBetaSL.naturalColor}</td><td>{arcteryxBetaSL.availability}</td></tr>
					</tbody>
				</table>
			</div>
		</section>

		<section id="verdict">
			<h2>結論</h2>
			<div class="verdict">
				<p class="kicker">条件別の整理</p>
				<p>現行のトレントフライヤーはモンベル公式が「極薄素材のため鋭利な岩角等で破損の恐れ」と注意書きしており、兼用運用を前提にすると耐摩耗性が判断の軸になる。</p>

				<div class="verdict-point">
					<p class="point-label">色・入手性・耐摩耗性のバランスを重視するなら</p>
					<p><strong>{tsurugiLightJacket.model}</strong>（{tsurugiLightJacket.naturalColor}、{tsurugiLightJacket.priceLabel}）が候補になる。重量増は{tsurugiLightJacket.weightDiff}と小さく、耐摩耗性も公式に明記されている。ナチュラルカラーの在庫もある。</p>
				</div>

				<div class="verdict-point">
					<p class="point-label">耐摩耗性を最優先するなら</p>
					<p><strong>{featherRainJacket.model}</strong>は耐摩耗性（20万回耐摩耗試験クリア）・重量（{featherRainJacket.weightDiff}）の面でむしろ優位だが、唯一のナチュラル色（Forest Green）が現在完売中のため、在庫が戻るまでは選択できない。</p>
				</div>

				<div class="verdict-point">
					<p class="point-label">初期投資を避けたいなら</p>
					<p>現行の{trentFlyer.model}を使い続け、運用でカバーする方法もある。日帰り等の軽装時はウィンドジャケットと両方携行し、10kg超の重量級山行時のみレインジャケット1着で兼用すれば、摩耗増加は限定的に抑えられる。</p>
				</div>
			</div>
		</section>

		<section style="margin-top: 3.2rem;">
			<div class="author-box">
				<div class="author-avatar"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 20l5-11 4 6 3-5 6 10H3z" fill="currentColor"/></svg></div>
				<div>
					<p class="author-label">Editor's Profile</p>
					<p class="author-name">かなた</p>
					<p class="author-bio">近畿地方在住。大峰山脈を拠点に、3シーズンから雪山まで登山を続けています。夏は信州アルプスまで足を伸ばし、テント泊装備でパックウェイト10kg前後の山行も。行動中の身軽さとテントでの睡眠の質を両立させたく、装備・パッキング・行程を毎回シミュレーションしてから臨み、その過程を記録しています。</p>
					<div class="author-tags"><span>大峰山脈拠点</span><span>テント泊中心</span><span>夏は信州アルプスも</span></div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
