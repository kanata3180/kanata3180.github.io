---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorBox from '../components/AuthorBox.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ProductCardList from '../components/ProductCardList.astro';
import SpecTable from '../components/SpecTable.astro';
import Callout from '../components/Callout.astro';
import { taniOsmo1P, hubbaHubbaLT1 } from '../data/products/index.js';

const base = import.meta.env.BASE_URL;

const cardConfigs = [
	{ product: taniOsmo1P, conditionLabel: '構成のシンプルさ・実績のある耐風性を重視するなら' },
	{ product: hubbaHubbaLT1, conditionLabel: '収納力・室内空間の使い勝手を重視するなら' },
];
const products = cardConfigs.map((c) => c.product);

const specFields = [
	{ key: 'dimensions', label: '寸法（長さ×幅）' },
	{ key: 'floorArea', label: '床面積', numeric: true, best: 'tani-osmo-1p' },
	{ key: 'weightBody', label: '重量（本体+ポール）', numeric: true, best: 'hubba-hubba-lt1' },
	{ key: 'weightTyvek', label: '重量（タイベック流用時）', numeric: true, best: 'hubba-hubba-lt1' },
	{ key: 'weightFootprint', label: '重量（純正フットプリント時）', numeric: true, best: 'hubba-hubba-lt1' },
	{ key: 'priceLabel', label: '価格' },
	{ key: 'vestibule', label: '前室', best: 'tani-osmo-1p' },
	{ key: 'interiorHeight', label: '室内高', best: 'tani-osmo-1p' },
	{ key: 'poleStructure', label: 'ポール構造' },
	{ key: 'windReport', label: '耐風性の実測報告', best: 'tani-osmo-1p' },
	{ key: 'condensation', label: '結露', best: 'tani-osmo-1p' },
	{ key: 'storage', label: '収納力', best: 'hubba-hubba-lt1' },
	{ key: 'setup', label: '設営' },
	{ key: 'japanSupport', label: '日本サポート' },
];
---

<BaseLayout
	title="NEMO Tani OSMO 1P vs Hubba Hubba LT1、耐風性と結露を検証 | やまかなた"
	description="自立式・ダブルウォールの1人用テント2機種を、耐風性・結露・収納・重量の実測データで比較。単位を揃えて検証すると見えてくる意外な結果。"
	currentCategory="テント"
>
	<main>
		<p class="breadcrumb"><a href={base}>ホーム</a> &gt; テント &gt; Tani OSMO 1P vs Hubba Hubba LT1</p>

		<div class="meta-row">
			<span class="cat-tag">テント</span>
			<span class="pub-date">{taniOsmo1P.verifiedDate} 更新</span>
		</div>

		<h1 class="title">NEMO Tani OSMO 1P vs Hubba Hubba LT1、耐風性と結露を検証</h1>

		<div class="hero">
			<svg viewBox="0 0 900 260" preserveAspectRatio="xMidYMid slice" role="img" aria-label="テント泊の稜線イラスト">
				<defs>
					<linearGradient id="sky2" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0%" stop-color="#3f7a72"/>
						<stop offset="100%" stop-color="#5c9a8f"/>
					</linearGradient>
				</defs>
				<rect width="900" height="260" fill="url(#sky2)"/>
				<path d="M0,200 L140,110 L240,170 L340,90 L460,190 L580,120 L700,200 L820,140 L900,190 L900,260 L0,260 Z" fill="#1a413c" opacity="0.9"/>
				<circle cx="150" cy="80" r="10" fill="#eaf3ef" opacity="0.55"/>
			</svg>
		</div>

		<p class="lede">
			自立式・ダブルウォールの1人用テントとして、{products.map((p) => `${p.brand} ${p.model}`).join('と')}を比較しました。「軽さ」だけでなく、耐風性の実測値を単位を揃えて比較し、収納力・結露・設営性まで含めて検証しています。
		</p>

		<TableOfContents items={[
			{ href: '#candidates', label: '候補2機種' },
			{ href: '#spec', label: '詳細スペック比較' },
			{ href: '#verdict', label: '結論' },
		]} />

		<ProductCardList
			heading="候補2機種"
			cards={cardConfigs}
			specs={[{ label: '重量', key: 'weight' }, { label: '床面積', key: 'floorArea' }]}
			icon={`<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 20h18L12 5 3 20z" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M12 5v15" stroke="currentColor" stroke-width="1.2"/></svg>`}
		/>

		<SpecTable caption={`${taniOsmo1P.verifiedDate}時点の調査データ（実使用レビューを含む）`} products={products} specFields={specFields} />

		<Callout kicker="訂正事項">
			<p>調査当初、レビューの一部に「Taniのインナーは無地・保温重視」という情報があったが、NEMO Equipment Japan公式ページで確認したところ<strong>インナーはメッシュが正しい仕様</strong>だった。また「Hubba Hubbaは垂直壁だから耐風性で明確に劣る」という初期の整理も、実地レビューを深掘りした結果、単位を揃えて比較する限り裏付けが弱いことが分かった。一次情報は途中で訂正が入ることがある、という記録としてここに残しておく。</p>
		</Callout>

		<section id="verdict">
			<h2>結論</h2>
			<div class="verdict">
				<p class="kicker">条件別の整理</p>
				<p>3機種ではなく2機種のみだが、単純な優劣ではなく優先順位次第で結論が変わる比較になった。</p>

				<div class="verdict-point">
					<p class="point-label">収納力・室内空間の使い勝手を重視するなら</p>
					<p><strong>{hubbaHubbaLT1.model}</strong>が候補になる。頭上ギアロフトとサイドメッシュポケットにより、{taniOsmo1P.model}の「ポケット1箇所」を大きく上回る。設営もハブ構造ゆえに部品点数は多いものの、対称設計のため設営難易度が上がっているという報告は見当たらない。</p>
				</div>

				<div class="verdict-point">
					<p class="point-label">構成のシンプルさ・実績のある耐風性を重視するなら</p>
					<p><strong>{taniOsmo1P.model}</strong>が候補になる。単位を揃えて比較すると、Taniの実測報告（15m/s）はHubba Hubbaの「一般的に対応可能」とされる範囲を上回っており、耐風性は少なくとも互角以上と見るのが妥当。ポール部品点数の少なさも、理論上の破損リスクの低さにつながる。</p>
				</div>

				<p>収納力を取るか、構成のシンプルさを取るかで結論が変わる比較であり、無理に一本化せず両論併記のまま記録しておく。</p>
			</div>
		</section>

		<AuthorBox />
	</main>
</BaseLayout>
