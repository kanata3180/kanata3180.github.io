---
import BaseLayout from '../layouts/BaseLayout.astro';
import { taniOsmo1P, hubbaHubbaLT1 } from '../data/products/index.js';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
	title="NEMO Tani OSMO 1P vs Hubba Hubba LT1、耐風性と結露を検証 | 稜線ノート"
	description="自立式・ダブルウォールの1人用テント2機種を、耐風性・結露・収納・重量の実測データで比較。単位を揃えて検証すると見えてくる意外な結果。"
	currentCategory="テント"
>
	<main>
		<p class="breadcrumb"><a href={base}>ホーム</a> &gt; テント &gt; Tani OSMO 1P vs Hubba Hubba LT1</p>

		<div class="meta-row">
			<span class="cat-tag">テント</span>
			<span class="pub-date">{taniOsmo1P.verifiedDate} 更新</span>
		</div>

		<h1 class="title">NEMO Tani OSMO 1P vs Hubba Hubba LT1、耐風性と結露を検証</h1>

		<div class="hero">
			<svg viewBox="0 0 900 260" preserveAspectRatio="xMidYMid slice" role="img" aria-label="テント泊の稜線イラスト">
				<defs>
					<linearGradient id="sky2" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0%" stop-color="#3f7a72"/>
						<stop offset="100%" stop-color="#5c9a8f"/>
					</linearGradient>
				</defs>
				<rect width="900" height="260" fill="url(#sky2)"/>
				<path d="M0,200 L140,110 L240,170 L340,90 L460,190 L580,120 L700,200 L820,140 L900,190 L900,260 L0,260 Z" fill="#1a413c" opacity="0.9"/>
				<circle cx="150" cy="80" r="10" fill="#eaf3ef" opacity="0.55"/>
			</svg>
		</div>

		<p class="lede">
			自立式・ダブルウォールの1人用テントとして、{taniOsmo1P.brand} {taniOsmo1P.model}と{hubbaHubbaLT1.brand} {hubbaHubbaLT1.model}を比較しました。「軽さ」だけでなく、耐風性の実測値を単位を揃えて比較し、収納力・結露・設営性まで含めて検証しています。
		</p>

		<div class="toc">
			<p class="toc-label">目次</p>
			<ol>
				<li><a href="#candidates">候補2機種</a></li>
				<li><a href="#spec">詳細スペック比較</a></li>
				<li><a href="#verdict">結論</a></li>
			</ol>
		</div>

		<section id="candidates">
			<h2>候補2機種</h2>
			<div class="product-list">

				<div class="product-card">
					<div class="thumb"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 20h18L12 5 3 20z" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M12 5v15" stroke="currentColor" stroke-width="1.2"/></svg></div>
					<div class="product-body">
						<p class="condition-label">構成のシンプルさ・実績のある耐風性を重視するなら</p>
						<p class="brand-name">{taniOsmo1P.brand}</p>
						<p class="model-name">{taniOsmo1P.model}</p>
						<p class="spec-line"><span>重量 <b>{taniOsmo1P.weight}</b></span><span>床面積 <b>{taniOsmo1P.floorArea}</b></span></p>
						<div class="shop-buttons">
							<span class="shop-btn-pending">Amazon商品リンク：準備中</span>
						</div>
					</div>
				</div>

				<div class="product-card">
					<div class="thumb"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 20h18L12 5 3 20z" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M12 5v15" stroke="currentColor" stroke-width="1.2"/></svg></div>
					<div class="product-body">
						<p class="condition-label">収納力・室内空間の使い勝手を重視するなら</p>
						<p class="brand-name">{hubbaHubbaLT1.brand}</p>
						<p class="model-name">{hubbaHubbaLT1.model}</p>
						<p class="spec-line"><span>重量 <b>{hubbaHubbaLT1.weight}</b>（トレイル重量）</span><span>床面積 <b>{hubbaHubbaLT1.floorArea}</b></span></p>
						<div class="shop-buttons">
							<span class="shop-btn-pending">Amazon商品リンク：準備中</span>
						</div>
					</div>
				</div>

			</div>
		</section>

		<section id="spec">
			<h2>詳細スペック比較</h2>
			<div class="table-wrap">
				<table>
					<caption>{taniOsmo1P.verifiedDate}時点の調査データ（実使用レビューを含む）</caption>
					<thead>
						<tr><th scope="col">項目</th><th scope="col">{taniOsmo1P.model}</th><th scope="col">{hubbaHubbaLT1.model}</th></tr>
					</thead>
					<tbody>
						<tr><th scope="row">寸法（長さ×幅）</th><td class="num">{taniOsmo1P.dimensions}</td><td class="num">{hubbaHubbaLT1.dimensions}</td></tr>
						<tr><th scope="row">床面積</th><td class="num best">{taniOsmo1P.floorArea}</td><td class="num">{hubbaHubbaLT1.floorArea}</td></tr>
						<tr><th scope="row">重量（本体+ポール）</th><td class="num">{taniOsmo1P.weightBody}</td><td class="num best">{hubbaHubbaLT1.weightBody}</td></tr>
						<tr><th scope="row">重量（タイベック流用時）</th><td class="num">{taniOsmo1P.weightTyvek}</td><td class="num best">{hubbaHubbaLT1.weightTyvek}</td></tr>
						<tr><th scope="row">重量（純正フットプリント時）</th><td class="num">{taniOsmo1P.weightFootprint}</td><td class="num best">{hubbaHubbaLT1.weightFootprint}</td></tr>
						<tr><th scope="row">前室</th><td class="best">{taniOsmo1P.vestibule}</td><td>{hubbaHubbaLT1.vestibule}</td></tr>
						<tr><th scope="row">室内高</th><td class="best">{taniOsmo1P.interiorHeight}</td><td>{hubbaHubbaLT1.interiorHeight}</td></tr>
						<tr><th scope="row">ポール構造</th><td>{taniOsmo1P.poleStructure}</td><td>{hubbaHubbaLT1.poleStructure}</td></tr>
						<tr><th scope="row">耐風性の実測報告</th><td class="best">{taniOsmo1P.windReport}</td><td>{hubbaHubbaLT1.windReport}</td></tr>
						<tr><th scope="row">結露</th><td class="best">{taniOsmo1P.condensation}</td><td>{hubbaHubbaLT1.condensation}</td></tr>
						<tr><th scope="row">収納力</th><td>{taniOsmo1P.storage}</td><td class="best">{hubbaHubbaLT1.storage}</td></tr>
						<tr><th scope="row">設営</th><td>{taniOsmo1P.setup}</td><td>{hubbaHubbaLT1.setup}</td></tr>
						<tr><th scope="row">日本サポート</th><td>{taniOsmo1P.japanSupport}</td><td>{hubbaHubbaLT1.japanSupport}</td></tr>
					</tbody>
				</table>
			</div>
		</section>

		<div class="verdict" style="margin-bottom: 3.2rem;">
			<p class="kicker">訂正事項</p>
			<p>調査当初、レビューの一部に「Taniのインナーは無地・保温重視」という情報があったが、NEMO Equipment Japan公式ページで確認したところ<strong>インナーはメッシュが正しい仕様</strong>だった。また「Hubba Hubbaは垂直壁だから耐風性で明確に劣る」という初期の整理も、実地レビューを深掘りした結果、単位を揃えて比較する限り裏付けが弱いことが分かった。一次情報は途中で訂正が入ることがある、という記録としてここに残しておく。</p>
		</div>

		<section id="verdict">
			<h2>結論</h2>
			<div class="verdict">
				<p class="kicker">条件別の整理</p>
				<p>3機種ではなく2機種のみだが、単純な優劣ではなく優先順位次第で結論が変わる比較になった。</p>

				<div class="verdict-point">
					<p class="point-label">収納力・室内空間の使い勝手を重視するなら</p>
					<p><strong>{hubbaHubbaLT1.model}</strong>が候補になる。頭上ギアロフトとサイドメッシュポケットにより、{taniOsmo1P.model}の「ポケット1箇所」を大きく上回る。設営もハブ構造ゆえに部品点数は多いものの、対称設計のため設営難易度が上がっているという報告は見当たらない。</p>
				</div>

				<div class="verdict-point">
					<p class="point-label">構成のシンプルさ・実績のある耐風性を重視するなら</p>
					<p><strong>{taniOsmo1P.model}</strong>が候補になる。単位を揃えて比較すると、Taniの実測報告（15m/s）はHubba Hubbaの「一般的に対応可能」とされる範囲を上回っており、耐風性は少なくとも互角以上と見るのが妥当。ポール部品点数の少なさも、理論上の破損リスクの低さにつながる。</p>
				</div>

				<p>収納力を取るか、構成のシンプルさを取るかで結論が変わる比較であり、無理に一本化せず両論併記のまま記録しておく。</p>
			</div>
		</section>

		<section style="margin-top: 3.2rem;">
			<div class="author-box">
				<div class="author-avatar"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 20l5-11 4 6 3-5 6 10H3z" fill="currentColor"/></svg></div>
				<div>
					<p class="author-label">Editor's Profile</p>
					<p class="author-name">かなた</p>
					<p class="author-bio">近畿地方在住。大峰山脈を拠点に、3シーズンから雪山まで登山を続けています。夏は信州アルプスまで足を伸ばし、テント泊装備でパックウェイト10kg前後の山行も。行動中の身軽さとテントでの睡眠の質を両立させたく、装備・パッキング・行程を毎回シミュレーションしてから臨み、その過程を記録しています。</p>
					<div class="author-tags"><span>大峰山脈拠点</span><span>テント泊中心</span><span>夏は信州アルプスも</span></div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
