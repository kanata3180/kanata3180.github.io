---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { articles } from '../../data/articles.js';
import { categories } from '../../data/categories.js';

export function getStaticPaths() {
	return categories.map((category) => ({
		params: { slug: category.slug },
		props: { category },
	}));
}

const { category } = Astro.props;
const base = import.meta.env.BASE_URL;
const categoryArticles = articles.filter((a) => a.category === category.name);
---

<BaseLayout
	title={`${category.name}の記事一覧 | やまかなた`}
	description={`やまかなたの「${category.name}」カテゴリに属する記事の一覧です。`}
	currentCategory={category.name}
>
	<main>
		<p class="breadcrumb"><a href={base}>ホーム</a> &gt; {category.name}</p>

		<div class="meta-row">
			<span class="cat-tag">{category.name}</span>
			<span class="pub-date">{categoryArticles.length}件の記事</span>
		</div>

		<h1 class="title">{category.name}の記事一覧</h1>

		<section>
			<div class="article-list">
				{categoryArticles.map((article) => (
					<ArticleRow article={article} base={base} />
				))}
			</div>
			{categoryArticles.length === 0 && (
				<p class="search-empty is-visible">このカテゴリの記事はまだありません。</p>
			)}
		</section>
	</main>
</BaseLayout>
