---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles.js';
import { categories } from '../../data/categories.js';

export function getStaticPaths() {
	return categories.map((category) => ({
		params: { slug: category.slug },
		props: { category },
	}));
}

const { category } = Astro.props;
const base = import.meta.env.BASE_URL;
const categoryArticles = articles.filter((a) => a.category === category.name);
---

<BaseLayout
	title={`${category.name}の記事一覧 | 稜線ノート`}
	description={`稜線ノートの「${category.name}」カテゴリに属する記事の一覧です。`}
	currentCategory={category.name}
>
	<main>
		<p class="breadcrumb"><a href={base}>ホーム</a> &gt; {category.name}</p>

		<div class="meta-row">
			<span class="cat-tag">{category.name}</span>
			<span class="pub-date">{categoryArticles.length}件の記事</span>
		</div>

		<h1 class="title">{category.name}の記事一覧</h1>

		<section>
			<div class="article-list">
				{categoryArticles.map((article) => (
					<a class="article-row" href={`${base}${article.slug}/`}>
						<div class="thumb-static">
							<svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
								<defs>
									<linearGradient id={`grad-${article.slug}`} x1="0" y1="0" x2="0" y2="1">
										<stop offset="0%" stop-color={article.thumbColors[0]} />
										<stop offset="100%" stop-color={article.thumbColors[1]} />
									</linearGradient>
								</defs>
								<rect width="100" height="100" fill={`url(#grad-${article.slug})`} />
							</svg>
						</div>
						<div>
							<span class="cat-tag">{article.category}</span>
							<p class="row-title">{article.title}</p>
							<p class="row-excerpt">{article.excerpt}</p>
						</div>
					</a>
				))}
			</div>
			{categoryArticles.length === 0 && (
				<p class="search-empty is-visible">このカテゴリの記事はまだありません。</p>
			)}
		</section>
	</main>
</BaseLayout>
