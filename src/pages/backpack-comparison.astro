---
import BaseLayout from '../layouts/BaseLayout.astro';
import { southwest40, betaLight45, lostCreekLT45 } from '../data/products/index.js';

const base = import.meta.env.BASE_URL;

const cardConfigs = [
	{ product: southwest40, conditionLabel: '耐荷重を重視するなら' },
	{ product: betaLight45, conditionLabel: '価格・国内サポートを重視するなら' },
	{ product: lostCreekLT45, conditionLabel: '価格を最優先するなら' },
];
const products = cardConfigs.map((c) => c.product);

const specFields = [
	{ key: 'capacity', label: '容量', numeric: true, best: 'beta-light-45' },
	{ key: 'weight', label: '重量', numeric: true, best: 'beta-light-45' },
	{ key: 'priceLabel', label: '価格', numeric: true, best: 'beta-light-45' },
	{ key: 'torsoAdjustment', label: 'トルソー調整', best: 'beta-light-45' },
	{ key: 'fabric', label: '素材' },
	{ key: 'frameStructure', label: 'フレーム構造' },
	{ key: 'waterproof', label: '防水性', best: ['southwest-40', 'beta-light-45'] },
	{ key: 'maxLoad', label: '最大耐荷重', numeric: true, best: 'southwest-40' },
	{ key: 'japanSupport', label: '日本サポート', best: 'beta-light-45' },
	{ key: 'stock', label: '在庫', best: 'beta-light-45' },
];

function isBest(field, product) {
	if (!field.best) return false;
	return Array.isArray(field.best) ? field.best.includes(product.id) : field.best === product.id;
}
---

<BaseLayout
	title="UL系40〜45Lザック3機種、テント泊装備との相性で比べる | やまかなた"
	description="登山装備の見直し記録を、実際に検討した一次情報に基づいて公開する軽量化シリーズ。第1回はザック比較。"
	currentCategory="ザック"
>
	<main>
		<p class="breadcrumb"><a href={base}>ホーム</a> &gt; ザック &gt; UL系40〜45Lザック比較</p>

		<div class="meta-row">
			<span class="cat-tag">ザック</span>
			<span class="pub-date">{southwest40.verifiedDate} 更新</span>
		</div>

		<h1 class="title">UL系40〜45Lザック3機種、テント泊装備との相性で比べる</h1>

		<div class="hero">
			<svg viewBox="0 0 900 260" preserveAspectRatio="xMidYMid slice" role="img" aria-label="山の稜線イラスト">
				<defs>
					<linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0%" stop-color="#235953"/>
						<stop offset="100%" stop-color="#3f7a72"/>
					</linearGradient>
				</defs>
				<rect width="900" height="260" fill="url(#sky)"/>
				<path d="M0,190 L120,90 L200,150 L300,60 L420,170 L520,100 L650,190 L760,120 L900,180 L900,260 L0,260 Z" fill="#1a413c" opacity="0.9"/>
				<path d="M0,220 L150,150 L260,200 L380,120 L500,210 L630,150 L780,215 L900,170 L900,260 L0,260 Z" fill="#123430"/>
			</svg>
		</div>

		<p class="lede">
			2泊3日のテント泊装備を基準に、{products.map((p) => `${p.brand} ${p.model}`).join('・')}の3機種のスペックを比較しました。容量・重量だけでなく、防水性・日本国内でのサポート体制・在庫状況までまとめています。
		</p>

		<div class="toc">
			<p class="toc-label">目次</p>
			<ol>
				<li><a href="#candidates">候補3機種</a></li>
				<li><a href="#spec">詳細スペック比較</a></li>
				<li><a href="#verdict">結論</a></li>
			</ol>
		</div>

		<section id="candidates">
			<h2>候補3機種</h2>
			<div class="product-list">
				{cardConfigs.map(({ product, conditionLabel }) => (
					<div class="product-card">
						<div class="thumb"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 20l3-14h10l3 14z" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M9 6V4h6v2" stroke="currentColor" stroke-width="1.6" fill="none"/></svg></div>
						<div class="product-body">
							<p class="condition-label">{conditionLabel}</p>
							<p class="brand-name">{product.brand}</p>
							<p class="model-name">{product.model}</p>
							<p class="spec-line"><span>重量 <b>{product.weight}</b></span><span>価格 <b>{product.priceLabel}</b></span></p>
							<div class="shop-buttons">
								<span class="shop-btn-pending">Amazon商品リンク：準備中</span>
							</div>
						</div>
					</div>
				))}
			</div>
		</section>

		<section id="spec">
			<h2>詳細スペック比較</h2>
			<div class="table-wrap">
				<table>
					<caption>{southwest40.verifiedDate}時点の調査データ</caption>
					<thead>
						<tr><th scope="col">項目</th>{products.map((p) => <th scope="col">{p.model}</th>)}</tr>
					</thead>
					<tbody>
						{specFields.map((field) => (
							<tr>
								<th scope="row">{field.label}</th>
								{products.map((p) => (
									<td class:list={[field.numeric && 'num', isBest(field, p) && 'best']}>{p[field.key]}</td>
								))}
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>

		<section id="verdict">
			<h2>結論</h2>
			<div class="verdict">
				<p class="kicker">条件別の整理</p>
				<p>3機種とも完全防水・シームテープ処理という点では差がなく、防水性は判断材料から外れる。残るポイントは価格・国内サポート・耐荷重の3点になる。</p>

				<div class="verdict-point">
					<p class="point-label">耐荷重を重視するなら</p>
					<p><strong>{southwest40.model}</strong>が候補になる。最大耐荷重{southwest40.maxLoad}という数値が明記されているのはこの中で{southwest40.model}だけで、テント泊装備一式を余裕を持って背負いたい場合の目安になる。ただし価格は{southwest40.priceLabel}とこの中で最も高い。</p>
				</div>

				<div class="verdict-point">
					<p class="point-label">価格と国内サポートのバランスを重視するなら</p>
					<p><strong>{betaLight45.model}</strong>が候補になる。{betaLight45.priceLabel}という価格に加え、{betaLight45.japanSupport}輸入という国内サポート体制がある。トルソー調整も{betaLight45.torsoAdjustment}と幅が広く、体格に合わせやすい。</p>
				</div>

				<div class="verdict-point">
					<p class="point-label">価格を最優先するなら</p>
					<p><strong>{lostCreekLT45.model}</strong>も選択肢に入る。{lostCreekLT45.priceLabel}とこの中で最も安いが、フル重量{lostCreekLT45.weight}は3機種で最も重く、防水も別体レインカバー前提になる。加えて現在{lostCreekLT45.stock}のため、購入前に在庫状況の確認が必要になる。</p>
				</div>

				<p>装備全体の軽量化目標と予算のどちらを優先するかによって、選ぶべき機種は変わってくる。</p>
			</div>
		</section>

		<section style="margin-top: 3.2rem;">
			<div class="author-box">
				<div class="author-avatar"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 20l5-11 4 6 3-5 6 10H3z" fill="currentColor"/></svg></div>
				<div>
					<p class="author-label">Editor's Profile</p>
					<p class="author-name">かなた</p>
					<p class="author-bio">近畿地方在住。大峰山脈を拠点に、3シーズンから雪山まで登山を続けています。夏は信州アルプスまで足を伸ばし、テント泊装備でパックウェイト10kg前後の山行も。行動中の身軽さとテントでの睡眠の質を両立させたく、装備・パッキング・行程を毎回シミュレーションしてから臨み、その過程を記録しています。</p>
					<div class="author-tags"><span>大峰山脈拠点</span><span>テント泊中心</span><span>夏は信州アルプスも</span></div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
