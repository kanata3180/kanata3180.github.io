---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorBox from '../components/AuthorBox.astro';
import { zpacksSlimStuffSack, seaToSummitUltrasil, hmgRolltopStuffSack, betaLight45 } from '../data/products/index.js';

const base = import.meta.env.BASE_URL;

const cardConfigs = [
	{ product: zpacksSlimStuffSack, conditionLabel: '直径の小ささ・軽量性を最優先するなら' },
	{ product: seaToSummitUltrasil, conditionLabel: '完全防水を優先し、直径に余裕があるなら' },
	{ product: hmgRolltopStuffSack, conditionLabel: '参考：完全防水ではなく重量記載もない' },
];
const products = cardConfigs.map((c) => c.product);

const specFields = [
	{ key: 'dimensionsTableLabel', label: '直径×高さ', numeric: true, best: 'zpacks-slim-stuff-sack' },
	{ key: 'capacity', label: '容量', numeric: true },
	{ key: 'waterproof', label: '防水性', best: 'sea-to-summit-ultrasil' },
	{ key: 'weight', label: '重量', numeric: true, best: 'zpacks-slim-stuff-sack' },
	{ key: 'priceLabel', label: '価格' },
];

function isBest(field, product) {
	if (!field.best) return false;
	return Array.isArray(field.best) ? field.best.includes(product.id) : field.best === product.id;
}
---

<BaseLayout
	title="主室スタッフバッグ3個運用、湿気を隔離するパッキング設計 | やまかなた"
	description="ジャンル別からシーン別へのパッキング再設計。Beta Light 45の実ポケット構成に当てはめた、スタッフバッグ選定と収納配置の記録。"
	currentCategory="パッキング"
>
	<main>
		<p class="breadcrumb"><a href={base}>ホーム</a> &gt; パッキング &gt; シーン別パッキング設計</p>

		<div class="meta-row">
			<span class="cat-tag">パッキング</span>
			<span class="pub-date">{zpacksSlimStuffSack.verifiedDate} 更新（仮記事）</span>
		</div>

		<h1 class="title">主室スタッフバッグ3個運用、湿気を隔離するパッキング設計</h1>

		<div class="hero">
			<svg viewBox="0 0 900 260" preserveAspectRatio="xMidYMid slice" role="img" aria-label="パッキングのイラスト">
				<defs>
					<linearGradient id="sky5" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0%" stop-color="#4b978a"/>
						<stop offset="100%" stop-color="#235953"/>
					</linearGradient>
				</defs>
				<rect width="900" height="260" fill="url(#sky5)"/>
				<rect x="330" y="70" width="240" height="160" rx="30" fill="#163e3a" opacity="0.6"/>
			</svg>
		</div>

		<p class="lede">
			「ジャンル別」に分けていたスタッフバッグを、「シーン別・使用タイミング別」に再設計しました。テントを取り出すために他の荷物を出す必要がある、という設営時の不便を解消するのが目的です。{betaLight45.model}の実ポケット構成に当てはめて検証しています。
		</p>

		<div class="toc">
			<p class="toc-label">目次</p>
			<ol>
				<li><a href="#packing-map">パッキングマップ</a></li>
				<li><a href="#candidates">テント用スタッフバッグ候補</a></li>
				<li><a href="#spec">詳細スペック比較</a></li>
				<li><a href="#verdict">結論</a></li>
			</ol>
		</div>

		<section id="packing-map">
			<h2>パッキングマップ</h2>
			<div class="table-wrap">
				<table>
					<caption>{betaLight45.model}の実ポケット構成に当てはめた配置</caption>
					<thead>
						<tr><th scope="col">収納場所</th><th scope="col">収納物</th></tr>
					</thead>
					<tbody>
						<tr><th scope="row">ショルダーハーネス（SNAP）</th><td>スマホ、行動食、サングラス、グローブ</td></tr>
						<tr><th scope="row">ヒップベルトポケット</th><td>ソフトフラスク、塩タブレット等の小物</td></tr>
						<tr><th scope="row">サイドポケット（左右）</th><td>レインウェア上下、ウィンドジャケット、救急セット即応品、キャンプ用ウォーターバッグ（空の状態で常時収納）</td></tr>
						<tr><th scope="row">主室：テント用バッグ</th><td>テント＋グラウンドシート。背面パネルに接する位置に縦向き配置（重量物を体に近い位置へ）</td></tr>
						<tr><th scope="row">主室：食事セット</th><td>ジェットボイル、リゾット、コーヒー、カトラリー</td></tr>
						<tr><th scope="row">主室：就寝セット</th><td>シュラフ、ピロー、予備衣類、防寒着、歯ブラシ</td></tr>
					</tbody>
				</table>
			</div>
			<p>行動中に使う物は外部ポケットに分散させることでスタッフバッグ化せず、主室内のバッグ数をジャンル別運用時の5個以上から3個まで削減した。ウォーターバッグを主室からサイドポケットへ移すことで、給水・調理時に主室を開ける必要がなくなる。</p>
		</section>

		<section id="candidates">
			<h2>テント用スタッフバッグ候補</h2>
			<p>夜露で湿ったテントをパッキングした際、湿気が就寝セット等に広がらないようにする観点で比較検討した。</p>
			<div class="product-list">
				{cardConfigs.map(({ product, conditionLabel }) => (
					<div class="product-card">
						<div class="thumb"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="7" y="4" width="10" height="16" rx="4" stroke="currentColor" stroke-width="1.6" fill="none"/></svg></div>
						<div class="product-body">
							<p class="condition-label">{conditionLabel}</p>
							<p class="brand-name">{product.brand}</p>
							<p class="model-name">{product.model}</p>
							<p class="spec-line"><span>直径×高さ <b>{product.dimensions}</b></span><span>容量 <b>{product.capacity}</b></span><span>重量 <b>{product.weight}</b></span></p>
							<div class="shop-buttons">
								<span class="shop-btn-pending">Amazon商品リンク：準備中</span>
							</div>
						</div>
					</div>
				))}
			</div>
		</section>

		<section id="spec">
			<h2>詳細スペック比較</h2>
			<div class="table-wrap">
				<table>
					<caption>{zpacksSlimStuffSack.verifiedDate}時点の調査データ</caption>
					<thead>
						<tr><th scope="col">製品</th>{specFields.map((f) => <th scope="col">{f.label}</th>)}</tr>
					</thead>
					<tbody>
						{products.map((p) => (
							<tr>
								<th scope="row">{p.brand} {p.model}</th>
								{specFields.map((field) => (
									<td class:list={[field.numeric && 'num', isBest(field, p) && 'best']}>{p[field.key]}</td>
								))}
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>

		<section id="verdict">
			<h2>結論</h2>
			<div class="verdict">
				<p class="kicker">条件別の整理</p>
				<p>HMG {hmgRolltopStuffSack.model}は完全防水ではなく重量の記載もなく、他の2製品に対する明確な強みが見当たらないため、候補からは外れる。判断は残り2製品の間で分かれる。</p>

				<div class="verdict-point">
					<p class="point-label">直径の小ささ・軽量性を最優先するなら</p>
					<p><strong>{zpacksSlimStuffSack.brand} {zpacksSlimStuffSack.model}</strong>が候補になる。直径{zpacksSlimStuffSack.dimensions.split('×')[0]}・重量{zpacksSlimStuffSack.weight}はこの中で最小・最軽量だが、防水性能は「Water Resistant」に留まる。内側に薄手のライナー（コンパクターバッグ等、10-20g程度）を追加すれば、直径条件を崩さずに湿気隔離を補える。</p>
				</div>

				<div class="verdict-point">
					<p class="point-label">完全防水を優先し、直径に余裕があるなら</p>
					<p><strong>{seaToSummitUltrasil.brand} {seaToSummitUltrasil.model}</strong>が候補になる。ロールトップ＋バックル構造で完全防水だが、直径{seaToSummitUltrasil.dimensions.split('×')[0]}・重量{seaToSummitUltrasil.weight}とZpacksより一回り大きく重い。背面配置での収まりに余裕がある場合の選択肢になる。</p>
				</div>
			</div>
		</section>

		<AuthorBox />
	</main>
</BaseLayout>
